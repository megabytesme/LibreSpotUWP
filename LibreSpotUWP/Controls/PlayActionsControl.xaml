<UserControl
    x:Class="LibreSpotUWP.Controls.PlayActionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Orientation="Horizontal" Spacing="12">
        <Button x:Name="BtnPlay" Style="{ThemeResource AccentButtonStyle}">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <FontIcon
                    FontFamily="Segoe MDL2 Assets"
                    Glyph="&#xE768;" />
            </StackPanel>
        </Button>
        <Button x:Name="BtnShuffle">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <FontIcon
                    FontFamily="Segoe MDL2 Assets"
                    Glyph="&#xE8B1;" />
            </StackPanel>
        </Button>
        <Button x:Name="BtnAddTo">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <FontIcon
                    x:Name="AddToIcon"
                    FontFamily="Segoe MDL2 Assets"
                    Glyph="&#xECC8;" />
            </StackPanel>
        </Button>
        <Button x:Name="BtnDownload">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <FontIcon
                    x:Name="DownloadIcon"
                    FontFamily="Segoe MDL2 Assets"
                    Glyph="&#xE896;" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
