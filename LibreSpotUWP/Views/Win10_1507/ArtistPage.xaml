<Page
    x:Class="LibreSpotUWP.Views.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LibreSpotUWP.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0">
            <StackPanel Padding="24">
                <StackPanel
                    x:Name="CacheIndicator"
                    Orientation="Horizontal"
                    Margin="0,0,0,24"
                    Visibility="Collapsed">
                    <FontIcon
                        Foreground="{ThemeResource SystemAccentColor}"
                        FontFamily="Segoe MDL2 Assets"
                        Glyph="&#xE946;" />
                    <TextBlock
                        x:Name="CacheIndicatorText"
                        Margin="0,0,8,0"
                        Foreground="{ThemeResource SystemAccentColor}"
                        Text="Cached" />
                    <Button
                        x:Name="RefreshButton"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        Click="RefreshButton_Click">
                        <FontIcon
                            Foreground="{ThemeResource SystemAccentColor}"
                            FontFamily="Segoe MDL2 Assets"
                            Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
                <controls:HeaderImageControl x:Name="HeaderControl" Margin="0,0,0,24" />
                <TextBlock Margin="0,0,0,12" Style="{StaticResource SubtitleTextBlockStyle}" Text="Top Tracks" />
                <controls:TrackListControl x:Name="TrackList" Margin="0,0,0,24" />
                <TextBlock Margin="0,0,0,12" Style="{StaticResource SubtitleTextBlockStyle}" Text="Albums" />
                <controls:AlbumGridControl x:Name="AlbumsGrid" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
