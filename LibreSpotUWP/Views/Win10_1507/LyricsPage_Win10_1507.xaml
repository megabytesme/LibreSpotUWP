<Page
    x:Class="LibreSpotUWP.Views.Win10_1507.LyricsPage_Win10_1507"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LibreSpotUWP.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock
                x:Name="TrackTitleText"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Lyrics" />

            <TextBlock
                x:Name="TrackSubtitleText"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Waiting for the current track..." />

            <StackPanel Orientation="Horizontal" Spacing="16">
                <ToggleSwitch
                    x:Name="AutoScrollToggle"
                    Header="Auto-scroll"
                    Toggled="AutoScrollToggle_Toggled" />

                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </StackPanel>

        <ListView
            x:Name="LyricsListView"
            Grid.Row="1"
            Margin="0,20,0,0"
            HorizontalContentAlignment="Stretch"
            IsItemClickEnabled="False"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:LibrespotLyricsLineData">
                    <Border
                        Margin="0,0,0,8"
                        Padding="16"
                        Background="{ThemeResource SystemControlBackgroundChromeLowBrush}"
                        CornerRadius="8">
                        <TextBlock
                            Text="{x:Bind Words}"
                            TextWrapping="WrapWholeWords" />
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
