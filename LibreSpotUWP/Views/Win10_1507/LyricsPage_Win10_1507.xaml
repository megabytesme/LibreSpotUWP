<Page
    x:Class="LibreSpotUWP.Views.Win10_1507.LyricsPage_Win10_1507"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LibreSpotUWP.Models"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel MaxWidth="840" HorizontalAlignment="Center">
            <TextBlock
                x:Name="TrackTitleText"
                MaxWidth="720"
                HorizontalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Lyrics"
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />

            <TextBlock
                x:Name="TrackSubtitleText"
                MaxWidth="720"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Waiting for the current track..."
                TextAlignment="Center"
                TextWrapping="WrapWholeWords" />

            <Grid MaxWidth="720" HorizontalAlignment="Stretch">
                <ToggleSwitch
                    x:Name="AutoScrollToggle"
                    Margin="0,16,0,16"
                    HorizontalAlignment="Left"
                    Header="Auto-scroll"
                    Toggled="AutoScrollToggle_Toggled" />
            </Grid>
        </StackPanel>

        <ScrollViewer
            x:Name="LyricsScrollViewer"
            Grid.Row="1"
            Margin="0,10,0,0"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            ViewChanged="LyricsScrollViewer_ViewChanged">
            <StackPanel
                x:Name="LyricsStack"
                MaxWidth="840"
                HorizontalAlignment="Center">
                <ListView
                    x:Name="LyricsListView"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    ContainerContentChanging="LyricsListView_ContainerContentChanging"
                    IsItemClickEnabled="True"
                    ItemClick="LyricsListView_ItemClick"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:LibrespotLyricsLineData">
                            <Grid Margin="0,0,0,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border
                                    x:Name="LineCard"
                                    Margin="0"
                                    Padding="20,16"
                                    Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}"
                                    CornerRadius="0">
                                    <TextBlock
                                        x:Name="LineText"
                                        MaxWidth="760"
                                        HorizontalAlignment="Center"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        LineHeight="30"
                                        LineStackingStrategy="BlockLineHeight"
                                        Text="{x:Bind DisplayWords}"
                                        TextAlignment="Center"
                                        TextWrapping="WrapWholeWords" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            MaxWidth="720"
            Margin="0,10,0,-10"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextWrapping="WrapWholeWords" />
    </Grid>
</Page>
