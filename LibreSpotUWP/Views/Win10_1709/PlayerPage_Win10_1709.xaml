<Page
    x:Class="LibreSpotUWP.Views.Win10_1709.PlayerPage_Win10_1709"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:LibreSpotUWP.Converters"
    SizeChanged="PlayerPage_SizeChanged">

    <Page.Resources>
        <converters:TimeConverter x:Key="TimeConverter" />
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundAcrylic}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button
            x:Name="MenuButton"
            Width="48"
            Height="48"
            Margin="8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="Transparent">
            <SymbolIcon Symbol="More" />
            <Button.Flyout>
                <Flyout>
                    <StackPanel Width="200">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Volume" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon
                                x:Name="VolumeIcon"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Glyph="&#xE994;" />
                            <Slider
                                x:Name="VolumeSlider"
                                Width="140"
                                Maximum="100"
                                Minimum="0"
                                ValueChanged="VolumeSlider_ValueChanged" />
                        </StackPanel>
                        <Button
                            Margin="0,16,0,0"
                            Click="ShareButton_Click"
                            Padding="10,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontFamily="Segoe MDL2 Assets"
                                    Glyph="&#xE72D;" />
                                <TextBlock Text="Share" />
                            </StackPanel>
                        </Button>
                        <Button
                            Margin="0,8,0,0"
                            Click="LyricsButton_Click"
                            Padding="10,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontFamily="Segoe MDL2 Assets"
                                    Glyph="&#xE720;" />
                                <TextBlock Text="Lyrics" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

        <StackPanel
            Grid.Row="0"
            Margin="24,24,24,20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <Button
                x:Name="ContextButton"
                HorizontalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="ContextButton_Click"
                Foreground="{ThemeResource SystemControlForegroundAccentBrush}"
                Padding="8,4"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ContextText"
                    FontSize="14"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
            </Button>

            <Image
                x:Name="AlbumArt"
                HorizontalAlignment="Center"
                Stretch="Uniform" />
        </StackPanel>

        <Grid
            Grid.Row="1"
            Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center">
                <StackPanel
                    x:Name="CacheIndicator"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
                    <FontIcon
                        Foreground="{ThemeResource SystemAccentColor}"
                        FontFamily="Segoe MDL2 Assets"
                        Glyph="&#xE946;" />
                    <TextBlock
                        x:Name="CacheIndicatorText"
                        Foreground="{ThemeResource SystemAccentColor}"
                        Text="Cached" />
                    <Button
                        x:Name="RefreshButton"
                        Width="28"
                        Height="28"
                        Background="Transparent"
                        Click="RefreshButton_Click">
                        <FontIcon
                            Foreground="{ThemeResource SystemAccentColor}"
                            FontFamily="Segoe MDL2 Assets"
                            Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
                <TextBlock
                    x:Name="TrackTitle"
                    FontSize="24"
                    FontWeight="SemiBold"
                    MaxLines="1"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />

                <Button
                    x:Name="TrackArtistButton"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="TrackArtistButton_Click"
                    Padding="8,4">
                    <TextBlock
                        x:Name="TrackArtist"
                        FontSize="16"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        MaxLines="1"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </Button>
            </StackPanel>

            <Grid
                Grid.Column="2"
                Margin="0,0,24,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <Button
                    x:Name="PersistButton"
                    Width="40"
                    Height="40"
                    Click="PersistButton_Click">
                    <FontIcon
                        x:Name="PersistIcon"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Glyph="&#xE710;" />
                </Button>
                <ProgressRing
                    x:Name="PersistProgressRing"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="ElapsedTime"
                Grid.Column="0"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                FontSize="12" />

            <Slider
                x:Name="PositionSlider"
                Grid.Column="1"
                Maximum="100"
                Minimum="0"
                IsThumbToolTipEnabled="True"
                PointerCaptureLost="PositionSlider_PointerCaptureLost"
                PointerPressed="PositionSlider_PointerPressed"
                PointerReleased="PositionSlider_PointerReleased"
                ThumbToolTipValueConverter="{StaticResource TimeConverter}"
                ValueChanged="PositionSlider_ValueChanged" />

            <TextBlock
                x:Name="TotalTime"
                Grid.Column="2"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="12" />
        </Grid>

        <Grid
            Grid.Row="3"
            Margin="0,0,0,24"
            VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal">

                <Button
                    x:Name="ShuffleButton"
                    Width="40"
                    Height="40"
                    Margin="0,0,20,0"
                    Click="ShuffleButton_Click">
                    <FontIcon
                        x:Name="ShuffleIcon"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Glyph="&#xE8B1;" />
                </Button>

                <Button
                    x:Name="PrevButton"
                    Width="48"
                    Height="48"
                    Margin="0,0,20,0"
                    Click="PrevButton_Click">
                    <SymbolIcon Symbol="Previous" />
                </Button>

                <Button
                    x:Name="PlayPauseButton"
                    Width="64"
                    Height="64"
                    Margin="0,0,20,0"
                    Click="PlayPauseButton_Click">
                    <SymbolIcon x:Name="PlayPauseIcon" Symbol="Play" />
                </Button>

                <Button
                    x:Name="NextButton"
                    Width="48"
                    Height="48"
                    Margin="0,0,20,0"
                    Click="NextButton_Click">
                    <SymbolIcon Symbol="Next" />
                </Button>

                <Button
                    x:Name="RepeatButton"
                    Width="40"
                    Height="40"
                    Click="RepeatButton_Click">
                    <FontIcon
                        x:Name="RepeatIcon"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Glyph="&#xF5E7;" />
                </Button>
            </StackPanel>

        </Grid>
    </Grid>
</Page>


