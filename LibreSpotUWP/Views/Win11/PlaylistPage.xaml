<Page
    x:Class="LibreSpotUWP.Views.Win11.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LibreSpotUWP.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="Transparent"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:HeaderImageControl
            x:Name="HeaderControl"
            Grid.Row="0"
            Margin="0,0,0,24" />

        <controls:PlayActionsControl
            x:Name="PlayActions"
            Grid.Row="1"
            Margin="0,0,0,24" />

        <TextBlock
            x:Name="SummaryText"
            Grid.Row="2"
            Margin="0,0,0,12"
            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />

        <StackPanel
            x:Name="CacheIndicator"
            Grid.Row="3"
            Margin="0,0,0,16"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                Foreground="{ThemeResource SystemAccentColor}"
                FontFamily="Segoe MDL2 Assets"
                Glyph="&#xE946;" />
            <TextBlock
                x:Name="CacheIndicatorText"
                Foreground="{ThemeResource SystemAccentColor}"
                Text="Cached" />
            <Button
                x:Name="RefreshButton"
                Width="28"
                Height="28"
                Background="Transparent"
                Click="RefreshButton_Click">
                <FontIcon
                    Foreground="{ThemeResource SystemAccentColor}"
                    FontFamily="Segoe MDL2 Assets"
                    Glyph="&#xE72C;" />
            </Button>
        </StackPanel>

        <controls:TrackListControl x:Name="TrackList" Grid.Row="4" />

        <Grid
            x:Name="LoadingOverlay"
            Grid.RowSpan="5"
            Background="#66000000"
            Visibility="Collapsed">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressRing
                    Width="40"
                    Height="40"
                    IsActive="True" />
                <TextBlock
                    x:Name="LoadingText"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    Text="Loading playlist..." />
            </StackPanel>
        </Grid>
    </Grid>
</Page>


