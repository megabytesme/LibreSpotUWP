<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <AcrylicBrush
                x:Key="AppBackgroundAcrylic"
                BackgroundSource="HostBackdrop"
                FallbackColor="#F2F2F2"
                TintColor="#FFFFFF"
                TintOpacity="0.5" />
            <AcrylicBrush
                x:Key="MediaBarBackgroundBrush"
                BackgroundSource="HostBackdrop"
                FallbackColor="#F2F2F2"
                TintColor="#FFFFFF"
                TintOpacity="0.5" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <AcrylicBrush
                x:Key="AppBackgroundAcrylic"
                BackgroundSource="HostBackdrop"
                FallbackColor="#202020"
                TintColor="#202020"
                TintOpacity="0.6" />
            <AcrylicBrush
                x:Key="MediaBarBackgroundBrush"
                BackgroundSource="HostBackdrop"
                FallbackColor="#202020"
                TintColor="#202020"
                TintOpacity="0.6" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppBackgroundAcrylic" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="MediaBarBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
